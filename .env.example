# Neon — プロジェクト設定の「接続文字列」からコピー（必ず ?sslmode=require 付き）
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxxx.region.aws.neon.tech/neondb?sslmode=require

# --- オプション: scripts/import-from-google-sheet.js で使う ---
# （Google Sheets API とサービスアカウント設定後）
# GOOGLE_APPLICATION_CREDENTIALS=C:\\path\\to\\service-account.json
# GOOGLE_SPREADSHEET_ID=
# GOOGLE_SHEET_NAME=利用者
# GOOGLE_SHEET_RANGE=A2:A500
# IMPORT_RECORDS_CSV=C:\\temp\\records.csv